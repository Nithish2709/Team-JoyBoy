# =============================================================================
# PDS Sentinel AI – .gitignore
# =============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.pyo
*.pyd
.Python
pip-log.txt
pip-delete-this-directory.txt
MANIFEST

# --- Virtual Environments ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- Environment & Secrets ---
.env
.env.*
!.env.example

# --- Testing & Coverage ---
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
nosetests.xml
*.cover
.hypothesis/

# --- Type Checking ---
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

# --- Alembic ---
# Keep versions folder tracked, ignore auto-generated pyc
alembic/versions/__pycache__/

# --- Logs ---
logs/
*.log
log/

# --- Docker ---
.dockerignore

# --- IDEs & Editors ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- OS ---
.DS_Store
Desktop.ini

# --- Node (if any frontend tooling added later) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Compiled Assets ---
*.pyc
*.pyo
staticfiles/
mediafiles/

# --- Jupyter Notebooks (if used for analysis) ---
.ipynb_checkpoints/

# --- SQLite (local dev fallback) ---
*.sqlite3
*.db
