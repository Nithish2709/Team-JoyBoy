# PDS Sentinel AI - Environment Variables Configuration Example
# Copy this file to .env and adjust configurations accordingly

ENVIRONMENT=development
DEBUG=true
PORT=8000
API_PREFIX=/api/v1
SECRET_KEY=replace_this_with_a_secure_cryptographic_random_key_64_bytes_long

# Database Configurations (PostgreSQL Asyncpg Connection Scheme)
DATABASE_URL=postgresql+asyncpg://pds_user:pds_password@localhost:5432/pds_sentinel_db

# Cache/Broker Configurations (Redis Connection Scheme)
REDIS_URL=redis://localhost:6379/0
